{
    "name": "magefan/module-google-tag-manager",
    "description": "Magento 2 Google Tag Manager and Google Analytics 4",
    "type": "magento2-module",
    "license": "proprietary",
    "authors": [
        {
            "name": "Magefan",
            "email": "support@magefan.com"
        }
    ],
    "version": "2.8.0",
    "require": {
        "magefan/module-community" : ">=2.3.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Magefan\\GoogleTagManager\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
